{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "analisiscartera",
  "version": "0.1.0",
  "identifier": "com.analisiscartera.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AnalisisCartera",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "visible": false,
        "backgroundColor": "#101216"
      },
      {
        "label": "splash",
        "title": "Analisis Cartera",
        "url": "splash.html",
        "width": 420,
        "height": 360,
        "center": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "backgroundColor": "#101216"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
